{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@casmo/tree.js": ["./src/index.ts"],
      "@casmo/tree.js/styles/*": ["./src/styles/*/index.ts"],
      "@casmo/tree.js/effects": ["./src/effects/index.ts"]
    }
  },
  "include": ["src", "test", "e2e", "examples", "editor", "*.ts"]
}
