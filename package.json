{
  "name": "@casmo/tree.js",
  "version": "0.1.0",
  "description": "Procedural trees for three.js (WebGPURenderer, TSL node materials).",
  "keywords": [
    "three",
    "three.js",
    "webgpu",
    "tsl",
    "procedural",
    "tree",
    "vegetation",
    "forest",
    "react-three-fiber"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casmo/tree.js.git"
  },
  "homepage": "https://github.com/Casmo/tree.js#readme",
  "bugs": {
    "url": "https://github.com/Casmo/tree.js/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/low-poly": {
      "types": "./dist/styles/low-poly/index.d.ts",
      "import": "./dist/styles/low-poly.js"
    },
    "./styles/stylized": {
      "types": "./dist/styles/stylized/index.d.ts",
      "import": "./dist/styles/stylized.js"
    },
    "./styles/realistic": {
      "types": "./dist/styles/realistic/index.d.ts",
      "import": "./dist/styles/realistic.js"
    },
    "./styles/painterly": {
      "types": "./dist/styles/painterly/index.d.ts",
      "import": "./dist/styles/painterly.js"
    },
    "./styles/whimsical": {
      "types": "./dist/styles/whimsical/index.d.ts",
      "import": "./dist/styles/whimsical.js"
    },
    "./styles/enchanted": {
      "types": "./dist/styles/enchanted/index.d.ts",
      "import": "./dist/styles/enchanted.js"
    },
    "./styles/stylized-painterly": {
      "types": "./dist/styles/stylized-painterly/index.d.ts",
      "import": "./dist/styles/stylized-painterly.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "import": "./dist/effects.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "import": "./dist/scene.js"
    },
    "./weather": {
      "types": "./dist/weather/index.d.ts",
      "import": "./dist/weather.js"
    },
    "./species": {
      "types": "./dist/species/index.d.ts",
      "import": "./dist/species.js"
    },
    "./species/*.json": "./dist/species/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "dev:editor": "vite --config editor/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:editor": "vite build --config editor/vite.config.ts",
    "build:examples": "vite build --config examples/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "readme-media": "node scripts/readme-media/capture.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "species": "node scripts/generate-species.mjs",
    "gallery": "node scripts/render-gallery.mjs"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9.0.0",
    "react": ">=19.0.0",
    "three": ">=0.187.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@react-three/fiber": "^9.8.2",
    "@react-three/test-renderer": "^9.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.187.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
