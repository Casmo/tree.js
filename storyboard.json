{ "title": "New Tree Effects: Inner Lines, outlines between trees, highlight and Tree ID",
  "kicker": "New · Tree Effects", "app": "tree-js",
  "url": "http://localhost:5291/examples/effects/?style=low-poly",
  "chapters": [
